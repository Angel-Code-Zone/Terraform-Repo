// Jenkinsfile for Modules & Multi Stages CICD pipeline.

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'plan', 'destroy'],
            description: 'Choose Terraform operation'
        )
    }

    stages {

        // ============================================================
        // CHECKOUT
        // ============================================================
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        // ============================================================
        // TERRAFORM VALIDATION
        // ============================================================
        stage('Terraform Validate') {
            steps {
                script {
                    ['dev', 'stage', 'prod'].each { environment ->

                        echo "Validating ${environment} environment..."

                        dir("Module_Multi-Environment/${environment}") {

                            withCredentials([
                                [$class: 'AmazonWebServicesCredentialsBinding',
                                 credentialsId: 'aws-terraform']
                            ]) {

                                sh '''
                                    terraform init
                                    terraform validate
                                '''
                            }
                        }
                    }
                }
            }
        }

        // ============================================================
        // DEV
        // ============================================================
        stage('DEV') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                echo "Deploying DEV environment..."

                dir('Module_Multi-Environment/dev') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {

                        sh '''
                            terraform init
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        // ============================================================
        // STAGE
        // ============================================================
        stage('STAGE') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                echo "Deploying STAGE environment..."

                dir('Module_Multi-Environment/stage') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {

                        sh '''
                            terraform init
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PROD
        // ============================================================
        stage('PROD') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                echo "Deploying PROD environment..."

                dir('Module_Multi-Environment/prod') {

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {

                        sh '''
                            terraform init
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        // ============================================================
        // PLAN
        // ============================================================
        stage('PLAN') {
            when {
                expression {
                    params.ACTION == 'plan'
                }
            }

            steps {
                script {
                    ['dev', 'stage', 'prod'].each { environment ->

                        echo "Running Terraform PLAN for ${environment}..."

                        dir("Module_Multi-Environment/${environment}") {

                            withCredentials([
                                [$class: 'AmazonWebServicesCredentialsBinding',
                                 credentialsId: 'aws-terraform']
                            ]) {

                                sh '''
                                    terraform init
                                    terraform plan
                                '''
                            }
                        }
                    }
                }
            }
        }

        // ============================================================
        // DESTROY
        // ============================================================
        stage('DESTROY') {
            when {
                expression {
                    params.ACTION == 'destroy'
                }
            }

            steps {
                script {

                    // Destroy PROD first, then STAGE, then DEV
                    ['prod', 'stage', 'dev'].each { environment ->

                        echo "Destroying ${environment} environment..."

                        dir("Module_Multi-Environment/${environment}") {

                            withCredentials([
                                [$class: 'AmazonWebServicesCredentialsBinding',
                                 credentialsId: 'aws-terraform']
                            ]) {

                                sh '''
                                    terraform init
                                    terraform destroy -auto-approve
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================
    post {

        success {
            echo '================================================'
            echo 'Terraform CI/CD Pipeline Completed Successfully'
            echo '================================================'
        }

        failure {
            echo '================================================'
            echo 'Terraform CI/CD Pipeline Failed'
            echo '================================================'
        }

        always {
            echo 'Terraform pipeline execution finished.'
        }
    }
}