// Jenkinsfile for Modules & Multi Stages CICD pipeline.

pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'plan', 'destroy'],
            description: 'Choose Terraform action'
        )
    }

    stages {

        stage('Terraform Validate') {
            steps {

                dir('Module_Multi-Environment/dev') {
                    sh '''
                        terraform init
                        terraform validate
                    '''
                }

                dir('Module_Multi-Environment/stage') {
                    sh '''
                        terraform init
                        terraform validate
                    '''
                }

                dir('Module_Multi-Environment/prod') {
                    sh '''
                        terraform init
                        terraform validate
                    '''
                }
            }
        }

        stage('DEV') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                dir('Module_Multi-Environment/dev') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        stage('STAGE') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                dir('Module_Multi-Environment/stage') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        stage('PROD') {
            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {
                dir('Module_Multi-Environment/prod') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh '''
                            terraform plan
                            terraform apply -auto-approve
                        '''
                    }
                }
            }
        }

        stage('PLAN') {
            when {
                expression {
                    params.ACTION == 'plan'
                }
            }

            steps {

                dir('Module_Multi-Environment/dev') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform plan'
                    }
                }

                dir('Module_Multi-Environment/stage') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform plan'
                    }
                }

                dir('Module_Multi-Environment/prod') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform plan'
                    }
                }
            }
        }

        stage('DESTROY') {
            when {
                expression {
                    params.ACTION == 'destroy'
                }
            }

            steps {

                dir('Module_Multi-Environment/dev') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform destroy -auto-approve'
                    }
                }

                dir('Module_Multi-Environment/stage') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform destroy -auto-approve'
                    }
                }

                dir('Module_Multi-Environment/prod') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-terraform']
                    ]) {
                        sh 'terraform destroy -auto-approve'
                    }
                }
            }
        }
    }
}